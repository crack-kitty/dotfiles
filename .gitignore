# Stale directory (renamed to claude/)
.claude/

# Sensitive data
.local.env
claude/.credentials.json
claude/*.key
claude/*.pem
claude/*.env
claude/*secret*
claude/*password*
claude/.mcp.json
claude/settings.local.json
codex/auth.json
codex/*.env
codex/*secret*
codex/*password*

# Machine-specific state
claude/.memhash/
claude/.last-cleanup
claude/.last-update-result.json
codex/cache/
codex/log/
codex/logs/
codex/sessions/
codex/tmp/

# Session and state data
claude/backups/
claude/mcp-needs-auth-cache.json
claude/sessions/
claude/CHECKPOINT
claude/.checkpoints/
claude/.session/
claude/.update.lock
claude/scheduled_tasks.lock
claude/history.jsonl
claude/history/
claude/research/
claude/stats-cache.json
claude/*.code-workspace

# Working directories
claude/cache/
claude/debug/
claude/downloads/
claude/file-history/
claude/ide/
claude/image-cache/
claude/paste-cache/
claude/plans/
claude/projects/
claude/session-env/
claude/shell-snapshots/
claude/tasks/
claude/tmp/
claude/todos/

# Logs (keep yt/.gitkeep and damage-control/.gitkeep)
claude/logs/*
!claude/logs/yt/.gitkeep
!claude/logs/damage-control/.gitkeep

# Plugins and telemetry
claude/plugins/
claude/statsig/
claude/telemetry/

# Specstory
claude/.specstory/

# Python cache
claude/**/__pycache__/
claude/**/*.pyc
