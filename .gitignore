claude/tmp/
claude/todos/

# Logs (keep yt/.gitkeep)
claude/logs/*
!claude/logs/yt/.gitkeep

# Plugins and telemetry
claude/plugins/
claude/statsig/
claude/telemetry/

# Specstory
claude/.specstory/
