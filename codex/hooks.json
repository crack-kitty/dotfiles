{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash '/home/dave/.codex/herdr-agent-state.sh' session",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "DASHBOARD_TRANSCRIPT_CWD=\"$PWD\" DASHBOARD_HOOK_CWD=\"$HOME\" bash \"$HOME/.dotfiles/scripts/dashboard-stop-hook.sh\" codex \"$HOME/.codex/dashboard-hook.log\"",
            "timeout": 180,
            "type": "command"
          }
        ]
      }
    ]
  }
}
